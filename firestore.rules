rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for Admin verification
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'anand.textme@gmail.com';
    }

    // =========================================================================
    // 1. COMMENTS COLLECTION SECURITY
    // =========================================================================
    match /comments/{commentId} {
      // 1a. Public Read: Anyone can read public comments
      allow read: if true;

      // 1b. Comment Creation: Authenticated users can post comments tied strictly to their own UID
      //     Enforces required & allowed fields, serverTimestamp for created_at, likes_count == 0
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
             'page_id', 'author_name', 'author_role', 'author_uid',
             'content', 'likes_count', 'created_at'
           ])
        && request.resource.data.keys().hasOnly([
             'page_id', 'author_name', 'author_role', 'author_uid',
             'content', 'likes_count', 'parent_id', 'created_at'
           ])
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.page_id is string
        && request.resource.data.likes_count == 0
        && request.resource.data.created_at == request.time
        && (!('parent_id' in request.resource.data) || request.resource.data.parent_id == null || request.resource.data.parent_id is string);

      // 1c. Comment Editing: Author can ONLY edit the 'content' field of their own comment (or admin)
      allow update: if request.auth != null
        && (
          isAdmin() ||
          (
            resource.data.author_uid == request.auth.uid
            && request.resource.data.author_uid == resource.data.author_uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 2000
          )
        );

      // 1d. Comment Deletion: Original author or Admin can delete comment
      allow delete: if request.auth != null
        && (resource.data.author_uid == request.auth.uid || isAdmin());

      // -----------------------------------------------------------------------
      // 1e. LIKES SUBCOLLECTION: comments/{commentId}/likes/{userId}
      // -----------------------------------------------------------------------
      match /likes/{userId} {
        // Public Read: Anyone can read likes to check like state or calculate like count
        allow read: if true;

        // User can create or delete ONLY their own like document matching their authenticated UID
        allow create, delete: if request.auth != null
          && (request.auth.uid == userId || isAdmin());

        // Direct updates to like documents are disabled
        allow update: if false;
      }
    }

    // =========================================================================
    // 2. MARKETING PARTNERS COLLECTION SECURITY
    // =========================================================================
    match /marketingPartners/{userId} {
      // 2a. Owner & Admin Read: Marketing partners or Admin can read profile
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // 2b. Profile Creation: Authenticated users can register their own document ID matching UID
      //     Enforces uid == request.auth.uid, totalClicks == 0, and registeredAt == request.time
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.totalClicks == 0
        && request.resource.data.registeredAt == request.time
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'email', 'phone', 'state', 'district', 'occupation',
             'registeredAt', 'acceptedTerms', 'acceptedMarketingConsent', 'totalClicks'
           ]);

      // 2c. Profile Update: Owner can ONLY update legitimate profile fields
      //     Prevents modifying uid, registeredAt, or totalClicks directly from the client
      allow update: if request.auth != null
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'name', 'email', 'phone', 'state', 'district', 'occupation',
                 'acceptedTerms', 'acceptedMarketingConsent'
               ])
          )
        );

      // 2d. Profile Deletion: Prevented from client SDK (unless Admin)
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. COMMENT REPORTS COLLECTION SECURITY
    // =========================================================================
    match /commentReports/{reportId} {
      // Admin can read, update status, or delete reports
      allow read, delete, update: if isAdmin();

      // Authenticated users can create ONLY their own report document matching reporterUid
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'commentId', 'reporterUid', 'reason', 'description', 'createdAt', 'status'
           ])
        && request.resource.data.reason in ['Spam', 'Advertising', 'Abusive', 'Offensive', 'Misleading', 'Other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    // =========================================================================
    // 4. JOB ALERT SUBSCRIPTIONS (Personalized Alerts)
    // =========================================================================
    match /job_alert_subscriptions/{subscriptionId} {
      // 4a. A user can read (get) their own subscription doc, or check existence before creation
      allow get: if request.auth != null && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      // 4b. A user can query (list) only their own subscriptions
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      // 4c. A user can create subscriptions only for themselves with matching doc ID
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.id == subscriptionId;

      // 4d. A user can modify or toggle only their own subscriptions
      allow update: if request.auth != null 
                    && (resource.data.userId == request.auth.uid || isAdmin())
                    && request.resource.data.userId == resource.data.userId;

      // 4e. A user can delete only their own subscriptions
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 5. NOTIFICATION LOGS (Telegram / Alert Delivery History)
    // =========================================================================
    match /notification_logs/{logId} {
      // Users can only view their own notification delivery logs (or admin)
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Client cannot write notification logs directly; only backend dispatch / Admin SDK
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. TELEGRAM ACCOUNT LINKS (Personalized Alert Delivery)
    // =========================================================================
    match /telegram_links/{userId} {
      // Users can read only their own connection record to check active status
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Allow authenticated candidates to disconnect / deactivate their own Telegram connection
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'updatedAt'])
          && request.resource.data.isActive == false
        )
      );

      // Allow candidates to delete their own Telegram link record when disconnecting
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Only verified server webhook / admin can create new paired connection records
      allow create: if isAdmin();
    }

    // =========================================================================
    // 7. TELEGRAM PAIRING TOKENS (Strictly Private to Server)
    // =========================================================================
    match /telegram_pairing_tokens/{token} {
      // Clients have zero direct access to connection tokens in Firestore.
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 8. PHASE 4: JOB ALERT BASELINE & SCHEDULER RUNS
    // =========================================================================
    match /job_alert_baseline/{jobId} {
      // Read & write strictly restricted to Admin (server uses Admin SDK)
      allow read, write: if isAdmin();
    }

    match /scheduler_runs/{runId} {
      // Admin can inspect scheduler run telemetry; client write disabled
      allow read: if isAdmin();
      allow write: if false;
    }

    match /scheduler_state/{docId} {
      // Admin can view scheduler state summary
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 9. STRICT DEFAULT DENY FOR ALL OTHER UNMATCHED PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
